# Grapevine — Environment Variables
# Copy this file to .env and fill in your values.
# With Expo SDK 45, load these via app.config.js using expo-constants,
# or use babel-plugin-transform-inline-environment-variables.

# ─── Backend ────────────────────────────────────────────────────────────────
GRAPEVINE_API_URL=https://your-backend-domain.com/api

# ─── Google OAuth ───────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend-domain.com/google/callback/success

# ─── TikTok OAuth ───────────────────────────────────────────────────────────
# Create an app at https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
